#!/usr/bin/env sh

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
BOOT_DOCTOR_JAR="$SCRIPT_DIR/../lib/boot-doctor.jar"

if [ ! -f "$BOOT_DOCTOR_JAR" ]; then
    BOOT_DOCTOR_JAR="$SCRIPT_DIR/../target/boot-doctor.jar"
fi

if [ ! -f "$BOOT_DOCTOR_JAR" ]; then
    echo 'Boot Doctor JAR not found. Reinstall Boot Doctor or run "mvn package".' >&2
    exit 1
fi

exec java -jar "$BOOT_DOCTOR_JAR" "$@"
